# Current environment name
NODE_ENV=local

# Postgres Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=camion

# Redis URI
REDIS_URI=redis://127.0.0.1:6379

# JWT Configuration
JWT_EXPIRES_IN=2592000
JWT_ISSUER=Camion

# Magic OTP
ENABLE_MAGIC_OTP=Yes
MAGIC_OTP=123456

# CORS
CORS_ORIGIN=*

# S3 Credentials
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=rustfsadmin
AWS_S3_SECRET_ACCESS_KEY=rustfsadmin
AWS_S3_BUCKET=camion

# TTL Time for client access token and refresh token
ACCESS_TOKEN_TTL=48h
REFRESH_TOKEN_TTL_DAYS=90d

#Skip cash sandbox testing
SKIPCASH_BASE_URL=https://skipcashtest.azurewebsites.net
SKIPCASH_CLIENT_ID=6fab9fb3-a5d1-4222-9cf9-01d14b43bacd
SKIPCASH_WEBHOOK_KEY=dd3d26c8-11b4-40b4-b27e-95c5ea829a8e
SKIPCASH_KEY_ID=301d1b2d-d58e-48b7-a671-b1ac5a116ae2
