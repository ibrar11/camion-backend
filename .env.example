# Current environment name
NODE_ENV=local

# Postgres Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=camion

# Redis URI
REDIS_URI=redis://127.0.0.1:6379

# JWT Configuration
JWT_EXPIRES_IN=86400000
JWT_ISSUER=Camion

# Magic OTP
ENABLE_MAGIC_OTP=Yes
MAGIC_OTP=123456

# CORS
CORS_ORIGIN=*

# S3 Credentials
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=rustfsadmin
AWS_S3_SECRET_ACCESS_KEY=rustfsadmin
AWS_S3_BUCKET=camion

# TTL Time for client access token and refresh token
ACCESS_TOKEN_TTL=48h
REFRESH_TOKEN_TTL_DAYS=90d

# Twilio Verify (set TWILIO_SMS_ENABLED=true to enable; leave false during development)
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MailChimp credentials
MAILCHIMP_API_KEY=your_api_key-us21
MAILCHIMP_AUDIENCE_ID=your_audience_id

#Skip cash sandbox testing
SKIPCASH_BASE_URL=https://skipcashtest.azurewebsites.net
SKIPCASH_CLIENT_ID=6fab9fb3-a5d1-4222-9cf9-01d14b43bacd
SKIPCASH_WEBHOOK_KEY=dd3d26c8-11b4-40b4-b27e-95c5ea829a8e
SKIPCASH_KEY_ID=301d1b2d-d58e-48b7-a671-b1ac5a116ae2
SKIPCASH_KEY_

#Skip cash 
SKIPCASH_PROD_BASE_URL=https://api.skipcash.app
SKIPCASH_PROD_KEY_ID=c7bf659a-1a74-41a7-8231-0982f576d761
SKIPCASH_PROD_KEY_

# SendGrid Email (set EMAIL_ENABLED=true to enable; leave false during development)
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@yourdomain.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid dynamic template IDs (create these in the SendGrid dashboard)
SENDGRID_TEMPLATE_OTP=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_CONFIRMED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_SHIPPED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_PROCESSING=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_DELIVERED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_CANCELLED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gull trans
GULLTRANS_BASE_URL=https://api-jiyun-v3.haiouoms.com
GULLTRANS_UUID=e69784f4-3855-416d-bede-2783a1381efa
GULLTRANS_AUTHORIZATION=1852be40-86e4-4ba7-9283-96b4f73b072e
GULLTRANS_WAREHOUSE_ID=your_warehouse-id
