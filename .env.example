# Current environment name
NODE_ENV=local

# Postgres Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=camion

# Assets Host
ASSETS_HOST=https://assets.dev.camiontrading.com

# Redis URI
REDIS_URI=redis://127.0.0.1:6379

# BullMQ Config
BULLMQ_HOST=YOUR_BULLMQ_HOST
BULLMQ_PORT=YOUR_BULLMQ_PORT

# JWT Configuration
JWT_EXPIRES_IN=86400000
JWT_ISSUER=Camion

# Magic OTP
ENABLE_MAGIC_OTP=Yes
MAGIC_OTP=123456

# CORS
CORS_ORIGIN=*

# S3 Credentials
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=rustfsadmin
AWS_S3_SECRET_ACCESS_KEY=rustfsadmin
AWS_S3_BUCKET=camion

# TTL Time for client access token and refresh token
ACCESS_TOKEN_TTL=48h
REFRESH_TOKEN_TTL_DAYS=90d

# Twilio Messaging Service (set TWILIO_SMS_ENABLED=true to enable; leave false during development)
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MailChimp credentials
MAILCHIMP_API_KEY=your_api_key-us21
MAILCHIMP_AUDIENCE_ID=your_audience_id

#Skip cash sandbox testing
SKIPCASH_BASE_URL=https://skipcashtest.azurewebsites.net
SKIPCASH_CLIENT_ID=YOUR_SKIPCASH_CLIENT_ID
SKIPCASH_WEBHOOK_KEY=YOUR_SKIPCASH_WEBHOOK_KEY
SKIPCASH_KEY_ID=YOUR_SKIPCASH_KEY_ID
SKIPCASH_KEY_SECRET=YOUR_SKIPCASH_KEY_SECRE

# SendGrid Email (set EMAIL_ENABLED=true to enable; leave false during development)
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@yourdomain.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid dynamic template IDs (create these in the SendGrid dashboard)
SENDGRID_TEMPLATE_OTP=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_CONFIRMED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_SHIPPED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_PROCESSING=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_DELIVERED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ORDER_CANCELLED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gull trans
GULLTRANS_BASE_URL=https://api-jiyun-v3.haiouoms.com
GULLTRANS_UUID=e69784f4-3855-416d-bede-2783a1381efa
GULLTRANS_AUTHORIZATION=1852be40-86e4-4ba7-9283-96b4f73b072e
GULLTRANS_WAREHOUSE_ID=your_warehouse-id
GULLTRANS_USER_ID=your_user_id

# Google OAuth
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_SECRET=your_google_web_client_secret
GOOGLE_CALLBACK_URL=https://your-api-domain/auth/google/callback
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
FRONTEND_REDIRECT_URL=https://your-frontend-domain/en

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://your-api-domain/auth/facebook/callback

# JOP WMS (Overseas Warehouse Management System)
JOP_WMS_BASE_URL=https://your-jop-wms-base-url
JOP_WMS_API_KEY=your_jop_api_key
JOP_WMS_API_SECRET=your_jop_api_secret
JOP_WMS_PROVIDER_API_KEY=your_jop_provider_api_key
JOP_WMS_USER_TOKEN=your_jop_user_token
JOP_WMS_WAREHOUSE_CODE=your_warehouse_code
JOP_WMS_LOGISTICS_CHANNEL=your_logistics_channel_code

# Product Translation
PRODUCT_TRANSLATION_BASE_URL=YOUR_PRODUCT_TRANSLATION_BASE_URL
