# Current environment name
NODE_ENV=local

# Postgres Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=camion

# Redis URI
REDIS_URI=redis://127.0.0.1:6379

# JWT Configuration
JWT_EXPIRES_IN=86400000
JWT_ISSUER=Camion

# Magic OTP
ENABLE_MAGIC_OTP=Yes
MAGIC_OTP=123456

# CORS
CORS_ORIGIN=*

# S3 Credentials
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=rustfsadmin
AWS_S3_SECRET_ACCESS_KEY=rustfsadmin
AWS_S3_BUCKET=camion

# TTL Time for client access token and refresh token
ACCESS_TOKEN_TTL=48h
REFRESH_TOKEN_TTL_DAYS=90d

# Gull trans
GULLTRANS_BASE_URL=https://api-jiyun-v3.haiouoms.com
GULLTRANS_UUID=e69784f4-3855-416d-bede-2783a1381efa
GULLTRANS_AUTHORIZATION=1852be40-86e4-4ba7-9283-96b4f73b072e